# MCM (IEPS 통합환경허가 관리) backend 환경 변수 예시

# 로컬 데이터 경로 (기본값: ../frontend/save). MCM에서는 ../scraper/save 권장.
# SCRAPING_DATA_DIR / EXTRACTED_DATA_DIR는 코드에서 BASE_DIR 기준으로 자동 설정됩니다.

# OCR 설정 (Windows에서 PaddleOCR GPU 미설치 시 false 권장)
OCR_USE_GPU=false

# Cloudflare R2 (선택). MCM 1차 라운드는 로컬 파일 시스템만 사용.
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=mcm-ieps

# AWS S3 운영 스토리지 (R2 대신 AWS에서 사용할 경우)
# AWS_REGION=ap-northeast-2
# MCM_STORAGE_BUCKET=mcm-ieps-staging-data

# Docker 컨테이너 여부
# DOCKER_ENV=false

# IEPS KSIC 매칭 보조 LLM (기본 비활성). OPENAI_API_KEY가 있을 때만 동작합니다.
# IEPS_KSIC_LLM_ENABLED=false
# IEPS_KSIC_LLM_MODEL=gpt-5.5-medium
# IEPS_KSIC_LLM_MAX_CANDIDATES=40
# OPENAI_API_KEY=
