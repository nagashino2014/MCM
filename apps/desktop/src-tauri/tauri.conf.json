{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCM",
  "version": "1.5.0",
  "identifier": "app.koensain.mcm.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MCM",
        "width": 1040,
        "height": 1060,
        "minWidth": 560,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign.ps1 %1",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"]
      }
    }
  }
}
