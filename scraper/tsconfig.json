{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "lib": ["ES2020", "DOM"],
    "types": ["node"]
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
