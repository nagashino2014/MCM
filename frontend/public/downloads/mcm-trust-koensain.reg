Windows Registry Editor Version 5.00

; MCM - koensain.app trust settings (per user, no admin needed). 2026-11-04
; 1) koensain.app -> Local intranet zone: files downloaded from it get no Mark-of-the-Web,
;    so Windows SmartScreen does not show "Windows protected your PC" for the widget installer.
; 2) Edge / Chrome download reputation allow-list for koensain.app.

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Internet Settings\ZoneMap\Domains\koensain.app]
"https"=dword:00000001

[HKEY_CURRENT_USER\Software\Policies\Microsoft\Edge\SmartScreenAllowListDomains]
"1"="koensain.app"

[HKEY_CURRENT_USER\Software\Policies\Google\Chrome\SafeBrowsingAllowlistDomains]
"1"="koensain.app"
