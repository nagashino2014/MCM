# SQLite 경로 (없으면 ../data/ieps/db.sqlite)
# IEPS_DB_PATH=C:\CodingProject\MCM\data\ieps\db.sqlite

# Auth.js v5 (NextAuth) — JWT 서명용 secret. 운영 시 32바이트 이상 랜덤.
AUTH_SECRET=replace-me-with-random-32bytes

# 첫 부팅 시 admin 계정이 0명이면 자동 시드되는 정보.
# 시드 후에도 환경변수는 그대로 유지해도 무방 (이미 admin 존재 시 시드 건너뜀).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme1234
ADMIN_NAME=관리자

# AWS 운영 모드 (로컬 개발에서는 비워둠)
# DATABASE_URL=postgresql://mcm:password@host:5432/mcm
# AWS_REGION=ap-northeast-2
# MCM_STORAGE_BUCKET=mcm-ieps-staging-data
# MCM_JOB_QUEUE_MODE=sqs
# MCM_JOB_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/123456789012/mcm-ieps-staging-jobs
