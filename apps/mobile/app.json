{
  "expo": {
    "name": "MCM",
    "slug": "mcm",
    "owner": "koensain",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mcm",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.koensain.mcm",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "app.koensain.mcm",
      "adaptiveIcon": {
        "backgroundColor": "#6b7cf6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6b7cf6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "명함을 촬영하기 위해 카메라를 사용합니다.",
          "photosPermission": "명함 이미지를 선택하기 위해 사진에 접근합니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "명함을 촬영하기 위해 카메라를 사용합니다.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#4A63D8",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "앱 잠금 해제를 위해 Face ID를 사용합니다."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "홈 화면 날씨 위젯에 현재 위치의 날씨를 표시하기 위해 사용합니다.",
          "locationWhenInUsePermission": "홈 화면 날씨 위젯에 현재 위치의 날씨를 표시하기 위해 사용합니다.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/m-app"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5fe91146-8d80-4a90-9cb1-8a472bf585d3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5fe91146-8d80-4a90-9cb1-8a472bf585d3"
    }
  }
}
