# CODEF 데모 연동 테스트용 키 (이 파일은 커밋됨 — 실제 값 넣지 말 것)
# 실제 값은 .env 로 복사해서 채운다 (.env 는 .gitignore 로 제외됨).
# 키 출처: CODEF 콘솔 > 키 관리 (데모버전 / 샌드박스)

CODEF_DEMO_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CODEF_DEMO_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

CODEF_SANDBOX_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CODEF_SANDBOX_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# public_key 본문(콘솔 상단 public_key 전체를 한 줄로, BEGIN/END 헤더 없이).
# 계정등록(createAccount) 시 인증서 비밀번호 RSA 암호화에 사용.
CODEF_PUBLIC_KEY=

# ── 계정등록(connectedId 발급)용 — 하나은행 기업계좌 / 공동인증서 ──
# 공동인증서(파일형) 폴더 안의 두 파일 경로. Windows 예:
#   C:\Users\<계정>\AppData\LocalLow\NPKI\<인증기관>\USER\<인증서명>\signCert.der
#   C:\Users\<계정>\AppData\LocalLow\NPKI\<인증기관>\USER\<인증서명>\signPri.key
HANA_CERT_DER_PATH=
HANA_CERT_KEY_PATH=
HANA_CERT_PASSWORD=

# 조회 대상 계좌번호(하이픈 포함/미포함 무관 — 스크립트가 숫자만 추출)
HANA_ACCOUNT=
